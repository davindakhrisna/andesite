[global]
    font = Iosevka Nerd Font 11
    corner_radius = 0
    origin = top-right
    offset = 14x14
    frame_width = 2
    frame_color = "{{color4}}"
    separator_color = "{{color8}}"
    padding = 12
    horizontal_padding = 16

[urgency_low]
    background = "{{background}}"
    foreground = "{{foreground}}"
    frame_color = "{{color8}}"

[urgency_normal]
    background = "{{background}}"
    foreground = "{{foreground}}"
    frame_color = "{{color4}}"

[urgency_critical]
    background = "{{background}}"
    foreground = "{{color1}}"
    frame_color = "{{color1}}"
