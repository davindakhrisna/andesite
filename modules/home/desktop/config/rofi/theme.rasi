@import "colors.rasi"

* {
    bg0:         @wallust-bg;
    bg1:         @wallust-bg-alt;
    bg2:         @wallust-border;
    fg0:         @wallust-fg;
    fg1:         @wallust-fg-alt;
    
    accent:      @wallust-accent;
    accent-alt:  @wallust-accent2;
    urgent:      @wallust-urgent;

    font:        "Iosevka Nerd Font 12";
    background-color: transparent;
    text-color:       @fg0;

    margin:      0px;
    padding:     0px;
    spacing:     0px;
}

window {
    location:    center;
    width:       540px;
    border:      2px;
    border-color: @accent;
    border-radius: 0px;
    background-color: @bg0;
}

mainbox {
    padding:     12px;
    spacing:     8px;
    children:    [ inputbar, listview ];
}

inputbar {
    spacing:     8px;
    padding:     8px 12px;
    border-radius: 0px;
    background-color: @bg1;
    border:      1px;
    border-color: @bg2;
    children:    [ prompt, entry ];
}

prompt {
    text-color:  @accent;
    font:        "Iosevka Nerd Font Bold 12";
}

entry {
    placeholder: "Type to search...";
    placeholder-color: @fg1;
    text-color:  @fg0;
}

listview {
    padding:     4px 0px;
    lines:       8;
    columns:     1;
    fixed-height: false;
    spacing:     4px;
}

element {
    padding:     8px 12px;
    spacing:     10px;
    border-radius: 0px;
}

element normal normal {
    background-color: transparent;
    text-color:       @fg0;
}

element normal urgent {
    background-color: @urgent;
    text-color:       @bg0;
}

element normal active {
    background-color: @bg1;
    text-color:       @accent;
}

element selected normal {
    background-color: @accent;
    text-color:       @bg0;
}

element selected active {
    background-color: @accent-alt;
    text-color:       @bg0;
}

element selected urgent {
    background-color: @urgent;
    text-color:       @bg0;
}

element-icon {
    size:        1.1em;
    vertical-align: 0.5;
}

element-text {
    text-color:  inherit;
    vertical-align: 0.5;
}
