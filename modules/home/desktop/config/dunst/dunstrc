# ==============================================================================
# OLED Monochrome Configuration for Dunst
# ==============================================================================
[global]
    font = Iosevka Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Geometry ###
    width = 340
    height = (0, 160)
    origin = top-right
    offset = (16, 16)
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### Visual Style (Strict Square / No Rounding) ###
    corner_radius = 0
    transparency = 0
    gap_size = 10
    separator_height = 0
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#ffffff"
    separator_color = "#262626"

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### History & Action ###
    sticky_history = yes
    history_length = 20
    dmenu = "rofi -dmenu -p dunst:"
    browser = "xdg-open"
    always_run_script = true
    title = Dunst
    class = Dunst

[urgency_low]
    background = "#000000"
    foreground = "#a3a3a3"
    frame_color = "#262626"
    highlight = "#ffffff"
    timeout = 4

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ffffff"
    highlight = "#ffffff"
    timeout = 6

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#ef4444"
    highlight = "#ef4444"
    timeout = 0

### Custom Rules ###

[gamemode_enabled]
    appname = "Game Mode"
    summary = "*ENABLED*"
    frame_color = "#22c55e"
    timeout = 3

[gamemode_disabled]
    appname = "Game Mode"
    summary = "*DISABLED*"
    frame_color = "#ffffff"
    timeout = 3

[nightlight_on]
    appname = "Night Light"
    summary = "*Activated*"
    frame_color = "#eab308"
    timeout = 3

[nightlight_off]
    appname = "Night Light"
    summary = "*Deactivated*"
    frame_color = "#ffffff"
    timeout = 3
