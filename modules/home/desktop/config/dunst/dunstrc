[global]
    font = Iosevka Nerd Font 11
    allow_markup = yes
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Geometry ###
    width = 340
    height = (0, 160)
    origin = top-right
    offset = 16x16
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### Visual Style (No Rounding / Sharp Box) ###
    corner_radius = 0
    transparency = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 12
    frame_width = 2
    frame_color = "#8e94a8"
    separator_color = "#8e94a8"

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    ### History & Action ###
    sticky_history = yes
    history_length = 20
    dmenu = "rofi -dmenu -p dunst:"
    browser = "xdg-open"
    always_run_script = true
    title = Dunst
    class = Dunst

[urgency_low]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#45475a"
    timeout = 4

[urgency_normal]
    background = "#181825"
    foreground = "#cdd6f4"
    frame_color = "#8e94a8"
    timeout = 6

[urgency_critical]
    background = "#181825"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
