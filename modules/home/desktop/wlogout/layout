{
    "label": "lock",
    "action": "hyprlock",
    "text": "[l] lock",
    "keybind": "l"
}
{
    "label": "suspend",
    "action": "systemctl suspend",
    "text": "[u] suspend",
    "keybind": "u"
}
{
    "label": "logout",
    "action": "hyprctl dispatch 'hl.dsp.exit()'",
    "text": "[e] logout",
    "keybind": "e"
}
{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "[r] reboot",
    "keybind": "r"
}
{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "[s] shutdown",
    "keybind": "s"
}